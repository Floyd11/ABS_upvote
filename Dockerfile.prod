# Dockerfile.prod - Монолит для деплоя на Render/Railway
# Объединяет Python Backend и Node.js tx-service в одном контейнере

FROM node:20-slim AS node-builder
WORKDIR /app/tx-service
COPY tx-service/package*.json ./
COPY tx-service/tsconfig.json ./
RUN npm install
COPY tx-service/src ./src
RUN npm run build

FROM python:3.11-slim
WORKDIR /app

# Установка Node.js (для запуска tx-service)
RUN apt-get update && apt-get install -y curl && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Копируем Python зависимости
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Копируем код бэкенда
COPY backend/ ./backend/
WORKDIR /app/backend

# Копируем собранный tx-service
COPY --from=node-builder /app/tx-service /app/tx-service

# Скрипт запуска
RUN echo '#!/bin/bash\n\
cd /app/tx-service && PORT=3010 node dist/index.js &\n\
cd /app/backend && uvicorn main:app --host 0.0.0.0 --port ${PORT:-8001}\n\
' > /app/start.sh && chmod +x /app/start.sh

CMD ["/app/start.sh"]
