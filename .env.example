# Database (отдельная схема в существующем PostgreSQL)
DATABASE_URL=postgresql+asyncpg://upvote_user:password@localhost:5432/postgres
DB_SCHEMA=upvote_bot

# Encryption key для сессионных ключей (генерируется: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your-fernet-key-here

# Abstract chain
ABSTRACT_RPC_URL=https://api.mainnet.abs.xyz
VOTING_CONTRACT=0x3B50dE27506f0a8C1f4122A1e6F470009a76ce2A
CHAIN_ID=2741

# Timestamp деплоя контракта (для расчёта epoch без RPC)
EPOCH_ZERO_TIMESTAMP=1730421821
EPOCH_DURATION_SECONDS=604800

# API
API_SECRET_KEY=change-me-to-random-string
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Scheduler
SCHEDULER_TIMEZONE=UTC
